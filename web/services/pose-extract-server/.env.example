# ---- Server ----
NODE_ENV=development
PORT=4000

# ---- Database (PostgreSQL) ----
# REQUIRED. The service connects to Postgres and applies the schema on boot
# (src/db/schema.sql). Use a hosted Postgres (e.g. Supabase) or a local one.
#
# Supabase hosted Postgres (pooler) example:
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Local Postgres example:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pose

# ---- Admin auth (Bearer token for /api/admin/*) ----
# REQUIRED. Use a strong random secret in production.
ADMIN_SECRET=change-me

# ---- Supabase auth ----
# SERVER-ONLY. Never expose this key to clients or include it in logs/responses.
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key

# ---- Cloudflare R2 (community image storage) ----
# REQUIRED. Community pose images are uploaded to R2, not the local filesystem.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=pose-dev
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# ---- Optional: rate limiting ----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=10

# ---- Optional: browser (worker / pose extraction) ----
BROWSER_APP_URL=https://gemini.google.com/app
BROWSER_PROFILE_DIR=./data/browser-profile
BROWSER_HEADLESS=true
PLAYWRIGHT_CHROME_CHANNEL=chrome
# BROWSER_PROFILE_DIR can point to a real Chrome profile clone (recommended)

# ---- Optional: Higgsfield CLI credentials (higgsfield_cli provider) ----
# Path of the OAuth credential file the CLI reads. Default: $HOME/.config/higgsfield/credentials.json
# (the CLI ignores XDG_CONFIG_HOME). Production points this at the Railway volume.
# HIGGSFIELD_CREDENTIALS_PATH=/app/higgsfield/credentials.json
# HIGGSFIELD_CLI_TIMEOUT_MS=600000
# Below this remaining lifetime the probe exits 3 and /api/health reports "warn".
# HIGGSFIELD_EXPIRING_SOON_SEC=86400
# Optional alert webhook for provider auth transitions (no secrets in the body, debounced 6h).
# ALERT_WEBHOOK_URL=https://hooks.example.com/your-endpoint

# ---- Local dev only ----
# Not used in production: in production community images are stored in R2.
# This directory is only used when NODE_ENV is not "production".
COMMUNITY_UPLOAD_DIR=./data/community

# ---- Optional: subscription entitlements (RevenueCat) ----
# SERVER-ONLY. Names only: never commit values, never expose them to a client.
# Leave unset and the entitlement routes answer 503 ENTITLEMENT_UNAVAILABLE while the
# webhook stays unmounted, so an unprovisioned deploy fails closed.
#   REVENUECAT_SECRET_API_KEY   REST v1 read of the subscriber (server-side secret key)
#   REVENUECAT_ENTITLEMENT_ID   the entitlement id configured in the RevenueCat dashboard
#   REVENUECAT_WEBHOOK_AUTH     dashboard webhook auth token; at least 32 characters

# ---- Optional: Sign in with Apple token revocation ----
# SERVER-ONLY. Names only: never commit values, never print them, never expose them.
# All four or none. Leave the block unset and an Apple-signed-in account cannot be
# deleted at all (503), which is the intended fail-closed behaviour: a deletion must
# never skip Apple's revoke. See DEPLOY_RUNBOOK.md section 6d.
#   APPLE_TEAM_ID              Apple Developer team identifier (JWT `iss`)
#   APPLE_CLIENT_ID            bundle identifier / Sign in with Apple client id (JWT `sub`)
#   APPLE_SIGNIN_KEY_ID        key id of the Sign in with Apple private key (JWT header `kid`)
#   APPLE_SIGNIN_PRIVATE_KEY   the .p8 contents; escaped \n newlines are accepted

# ---- Required variables (service fails to boot without these) ----
# DATABASE_URL, ADMIN_SECRET, R2_ACCOUNT_ID, R2_ACCESS_KEY_ID,
# R2_SECRET_ACCESS_KEY, R2_BUCKET, R2_PUBLIC_URL
