{
  "name": "pose-extract-server",
  "version": "1.0.0",
  "private": true,
  "description": "Pose extract server skeleton",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-schema.mjs",
    "start": "node dist/index.js",
    "worker": "tsx src/worker/worker-main.ts",
    "worker:preflight": "tsx src/worker/preflight-auth.ts",
    "worker:login": "tsx src/worker/login-auth.ts",
    "start:worker": "node dist/worker/worker-main.js",
    "start:worker:preflight": "node dist/worker/preflight-auth.js",
    "start:worker:login": "node dist/worker/login-auth.js",
    "test": "vitest run",
    "test:lineart-bg": "python3 -m unittest discover -s scripts -p 'test_*.py'",
    "test:watch": "vitest",
    "lint": "tsc --noEmit -p tsconfig.json",
    "spike:boot-check": "npm run build && node scripts/check-boot-with-mounted-path.mjs",
    "spike:docker-viability": "bash scripts/check-container-viability.sh",
    "probe:higgsfield-auth": "bash scripts/higgsfield-auth-probe.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1041.0",
    "@aws-sdk/s3-request-presigner": "^3.1041.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "multer": "^2.1.1",
    "pino": "^10.3.1",
    "playwright": "^1.59.1",
    "postgres": "^3.4.9",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@electric-sql/pglite-socket": "^0.2.8",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.6.0",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  }
}
