# iosApp/Podfile
platform :ios, '15.0'

target 'iosApp' do
  use_frameworks!
  pod 'composeApp', :path => '../composeApp'
  pod 'MijickCamera', '~> 3.0.0'

  # FEAT-010 / DEC-007: native iOS Firebase SDKs via the existing CocoaPods lane.
  # Versions are resolved by CocoaPods against this toolchain (Xcode 26.1.1,
  # CocoaPods 1.16.2) and pinned in Podfile.lock; no unrelated upgrades.
  # The composeApp KMP podspec declares the same deps for cinterop generation.
  pod 'FirebaseCore'
  pod 'FirebaseAnalytics'
  pod 'FirebaseCrashlytics'
  pod 'FirebaseRemoteConfig'

  post_install do |installer|
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['OTHER_LDFLAGS'] ||= ['$(inherited)']
        flags = config.build_settings['OTHER_LDFLAGS']
        flags = [flags] unless flags.is_a?(Array)
        flags << '-lsqlite3' unless flags.include?('-lsqlite3')
        config.build_settings['OTHER_LDFLAGS'] = flags

        # Disable Swift 6 strict concurrency via compiler flag (overrides xcconfig)
        config.build_settings['SWIFT_STRICT_CONCURRENCY'] = 'minimal'
        other_swift_flags = config.build_settings['OTHER_SWIFT_FLAGS'] || '$(inherited)'
        unless other_swift_flags.include?('-strict-concurrency=minimal')
          config.build_settings['OTHER_SWIFT_FLAGS'] = "#{other_swift_flags} -strict-concurrency=minimal"
        end
        config.build_settings['SWIFT_VERSION'] = '5.9' if target.name.start_with?('Mijick')
      end
    end

    # Patch MijickCamera: add @MainActor to protocol extensions that call @MainActor CameraManager
    mijick_screen = File.join(installer.sandbox.root, 'MijickCamera/Sources/Public/UI/Public+UI+MCameraScreen.swift')
    if File.exist?(mijick_screen)
      content = File.read(mijick_screen)
      patched = content.gsub(/^public extension MCameraScreen \{/, '@MainActor public extension MCameraScreen {')
      File.write(mijick_screen, patched) if content != patched
    end

    installer.aggregate_targets.each do |aggregate_target|
      aggregate_target.user_project.native_targets.each do |native_target|
        native_target.build_configurations.each do |config|
          existing = config.build_settings['OTHER_LDFLAGS'] || '$(inherited)'
          value = existing.is_a?(Array) ? existing.join(' ') : existing.to_s
          config.build_settings['OTHER_LDFLAGS'] = "#{value} -lsqlite3" unless value.include?('-lsqlite3')
        end
      end
      aggregate_target.user_project.save
    end

    # FEAT-011 / lane app-icon-testflight-resubmit: strip CFBundleExecutable from
    # every *_Privacy resource bundle (FBLPromises, Firebase*, Google*, ...).
    # Root cause: the archive passes INFOPLIST_FILE=<temp plist> on the command
    # line to force CFBundleVersion (build number). That override also reaches the
    # Pods resource-bundle targets, so their generated Info.plist inherits the app
    # plist's `CFBundleExecutable = $(EXECUTABLE_NAME)`, which expands to the
    # bundle product name. The bundle ships no executable, and App Store Connect
    # validation rejects the IPA with -19241 ("Unexpected CFBundleExecutable Key",
    # e.g. FBLPromises_Privacy.bundle).
    # Fix: (1) a Run Script build phase on every *_Privacy target removes the key
    # from the BUILT bundle before it is embedded into its framework and
    # code-signed (signature therefore covers the stripped plist); (2) strip the
    # key from the generated ResourceBundle-*_Privacy plists as well.
    privacy_targets = installer.pods_project.targets.select { |t| t.name =~ /_Privacy\z/ }
    privacy_targets.each do |target|
      target.build_configurations.each do |config|
        # Let the strip script write inside the product dir on Xcode 15+.
        config.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'
      end
      next if target.build_phases.any? { |p| p.respond_to?(:display_name) && p.display_name == 'Strip CFBundleExecutable from Privacy Bundle' }
      phase = target.new_shell_script_build_phase('Strip CFBundleExecutable from Privacy Bundle')
      phase.always_out_of_date = '1'
      phase.shell_script = <<~STRIP
        # Remove CFBundleExecutable from every *_Privacy.bundle Info.plist: the
        # bundle declares an executable it does not contain, which App Store
        # Connect validation rejects (-19241). Runs before embedding + codesign.
        for info in "${BUILT_PRODUCTS_DIR}"/*_Privacy.bundle/Info.plist; do
          [ -f "$info" ] || continue
          /usr/libexec/PlistBuddy -c "Delete :CFBundleExecutable" "$info" 2>/dev/null || true
        done
      STRIP
    end

    # Belt & braces: strip the key from the generated resource-bundle plists.
    Dir[File.join(installer.sandbox.root, 'Target Support Files', '**', 'ResourceBundle-*_Privacy-*-Info.plist')].each do |plist|
      system('/usr/libexec/PlistBuddy', '-c', 'Delete :CFBundleExecutable', plist)
    end
  end
end
