// Production release configuration. Public SDK/legal values are placeholders.
AIPOSE_ENVIRONMENT = PROD
AIPOSE_BUILD_CONFIGURATION = Release
REVENUECAT_PUBLIC_SDK_KEY = REPLACE_WITH_PROD_PUBLIC_SDK_KEY
DEVELOPMENT_TEAM = WZL67P53F2

// The entitlement id shipped in this build. Must match the RevenueCat dashboard.
REVENUECAT_ENTITLEMENT_ID = posing_pro

// Local, gitignored key source, included after the placeholder above so the real key wins, and
// required for this configuration: the "RevenueCat key provenance" build phase fails a
// Release-Prod build that resolves to a placeholder. A clean release worktree must copy
// mobile/.env in before archiving. See REVENUECAT_SETUP.md.
#include? "../../.env"
