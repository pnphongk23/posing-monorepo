// Development debug configuration. Public SDK/legal values are placeholders.
AIPOSE_ENVIRONMENT = DEV
AIPOSE_BUILD_CONFIGURATION = Debug
REVENUECAT_PUBLIC_SDK_KEY = REPLACE_WITH_DEV_PUBLIC_SDK_KEY
DEVELOPMENT_TEAM = WZL67P53F2

// The entitlement id shipped in this build. Must match the RevenueCat dashboard.
REVENUECAT_ENTITLEMENT_ID = posing_pro

// Local, gitignored key source, included after the placeholder above so the real key wins.
// mobile/.env holds the PROD App Store public key; a clean release worktree must copy it in
// before archiving. See REVENUECAT_SETUP.md.
#include? "../../.env"

// Local, gitignored Test Store override. Included last on purpose: it only ever wins here, in
// Debug-Dev. The Release configurations must never include it — a RevenueCat Test Store key
// must not reach a shipping build. See REVENUECAT_SETUP.md.
#include? "Secrets.local.xcconfig"
