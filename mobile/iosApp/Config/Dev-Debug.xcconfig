// Development debug configuration. Public SDK/legal values are placeholders.
#include "../Pods/Target Support Files/Pods-iosApp/Pods-iosApp.debug-dev.xcconfig"
AIPOSE_ENVIRONMENT = DEV
AIPOSE_BUILD_CONFIGURATION = Debug
REVENUECAT_PUBLIC_SDK_KEY = REPLACE_WITH_DEV_PUBLIC_SDK_KEY
LEGAL_TERMS_URL = https:/$()/sites.google.com/view/snappose/terms-of-service
LEGAL_PRIVACY_URL = https:/$()/sites.google.com/view/snappose/privacy-policy
