// Production environment with debug compiler settings for local verification.
// The premium bypass remains disabled because the environment is PROD.
AIPOSE_ENVIRONMENT = PROD
AIPOSE_BUILD_CONFIGURATION = Debug
REVENUECAT_PUBLIC_SDK_KEY = REPLACE_WITH_PROD_PUBLIC_SDK_KEY
DEVELOPMENT_TEAM = WZL67P53F2

// The entitlement id shipped in this build. Must match the RevenueCat dashboard.
REVENUECAT_ENTITLEMENT_ID = posing_pro

// Local, gitignored key source, included after the placeholder above so the real key wins.
// mobile/.env holds the PROD App Store public key; a clean release worktree must copy it in
// before archiving. See REVENUECAT_SETUP.md.
#include? "../../.env"
