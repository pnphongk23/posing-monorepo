-- shared/src/commonMain/sqldelight/com/aipose/Pose.sq
CREATE TABLE Pose (
    poseId TEXT PRIMARY KEY,
    ownerAccountId TEXT NOT NULL,
    name TEXT NOT NULL,
    description TEXT,
    tags TEXT NOT NULL DEFAULT '[]',
    difficulty TEXT,
    bodyParts TEXT NOT NULL DEFAULT '[]',
    status TEXT NOT NULL DEFAULT 'local' CHECK(status IN ('local', 'published')),
    originalPath TEXT NOT NULL,
    skeletonPath TEXT NOT NULL,
    thumbnailPath TEXT NOT NULL,
    currentJobId TEXT,
    createdAt TEXT NOT NULL,
    updatedAt TEXT NOT NULL
);

CREATE INDEX idx_pose_createdAt ON Pose(createdAt);
CREATE INDEX idx_pose_ownerAccountId ON Pose(ownerAccountId);
CREATE INDEX idx_pose_status ON Pose(status);

getAllPoses:
SELECT * FROM Pose ORDER BY createdAt DESC;

getPoseById:
SELECT * FROM Pose WHERE poseId = ?;

getMyPoses:
SELECT * FROM Pose WHERE status = 'local' ORDER BY createdAt DESC;

insertPose:
INSERT INTO Pose(
    poseId,
    ownerAccountId,
    name,
    description,
    tags,
    difficulty,
    bodyParts,
    status,
    originalPath,
    skeletonPath,
    thumbnailPath,
    currentJobId,
    createdAt,
    updatedAt
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deletePose:
DELETE FROM Pose WHERE poseId = ?;

updatePose:
UPDATE Pose
SET name = ?, description = ?, tags = ?, difficulty = ?, bodyParts = ?, status = ?, updatedAt = ?
WHERE poseId = ?;

insertPoseWithId:
INSERT INTO Pose(
    poseId,
    ownerAccountId,
    name,
    description,
    tags,
    difficulty,
    bodyParts,
    status,
    originalPath,
    skeletonPath,
    thumbnailPath,
    currentJobId,
    createdAt,
    updatedAt
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);
