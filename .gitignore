# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/web/admin-ui/node_modules
/web/services/pose-extract-server/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/web/admin-ui/.next/
/web/admin-ui/out/
/out/

# production
/build
/.gradle
*/build
/mobile/iosApp/build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE
*.iml
.idea/
local.properties

# iOS / Xcode
mobile/iosApp/*.xcworkspace/xcuserdata/
mobile/iosApp/*.xcodeproj/xcuserdata/
*.xcuserstate
DerivedData/

# FEAT-010: real Firebase config is supplied out of band, never committed.
GoogleService-Info.plist

# worktrees
.worktrees/

# local docker volumes (credentials + sqlite)
.docker-persist/
.kotlin
# Local runtime data — never commit
.docker-data/

# local-only xcconfig overrides (RevenueCat keys etc.), never commit
mobile/iosApp/Config/*.local.xcconfig
# local-only Maestro E2E credentials, never commit
mobile/iosApp/maestro/*.local.env
