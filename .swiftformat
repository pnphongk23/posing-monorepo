# SwiftFormat — formatting gate for the native iOS lane (mobile/iosApp).
#
# Install: brew install swiftformat   (brew binary, tested with 0.64.4 — nothing joins the
# app target, the SwiftPM graph, or an Xcode build phase).
# The gate only LINTs; it never rewrites the tree:
#   swiftformat --lint mobile/iosApp/iosApp mobile/iosApp/iosAppTests
#   swiftformat --lint <staged files>            # what scripts/git-hooks/pre-commit runs
#
# Rule selection is an explicit allow-list, not "defaults minus a few". The allow-list is
# exactly the default rule set that the current tree already satisfies, so `--lint` is green
# today and any new file has to match it. The formatting rules the legacy code violates are
# listed at the bottom as debt: pay them back in dedicated behavior-preserving reformat
# commits (tests green before and after), promoting each rule from debt to the allow-list.
# Never enable a rule and reformat legacy files inside a feature commit.

--swiftversion 6.0
--indent 4
--rules anyObjectProtocol,applicationMain,assertionFailures,blankLineAfterImports,blankLinesBetweenChainedFunctions,blankLinesBetweenImports,consistentSwitchCaseSpacing,docCommentsBeforeModifiers,duplicateImports,emptyBraces,enumNamespaces,environmentEntry,extensionAccessControl,extensionAttributes,fileHeader,fileMacro,genericExtensions,headerFileName,initCoderUnavailable,leadingDelimiters,linebreakAtEndOfFile,linebreaks,modifiersOnSameLine,nestedIf,noForceTryInTests,preferForLoop,redundantBackticks,redundantBreak,redundantEnumerated,redundantEquatable,redundantExtensionACL,redundantFileprivate,redundantGet,redundantInit,redundantInternal,redundantLetError,redundantObjc,redundantOptionalBinding,redundantPattern,redundantPublic,redundantRawValues,redundantStaticSelf,redundantSwiftTestingSuite,redundantSwiftUIGroup,redundantTypedThrows,redundantVoidReturnType,semicolons,sortDeclarations,sortTypealiases,spaceAroundBrackets,spaceAroundComments,spaceAroundGenerics,spaceAroundParens,spaceInsideBraces,spaceInsideBrackets,spaceInsideComments,spaceInsideGenerics,spaceInsideParens,strongOutlets,strongifiedSelf,swiftTestingTestCaseNames,todos,trailingSpace,typeSugar,void,wrap,wrapAttributes,wrapSingleLineComments,yodaConditions

# Debt — the formatting rules the current tree does NOT satisfy, measured with
# `swiftformat --lint` on 2026-10-29 (top offenders: wrapIfStatementBodies 324, indent 241,
# wrapFunctionBodies 161, redundantReturn 155, redundantSelf 98, unusedArguments 96,
# sortImports 87, hoistPatternLet 84, hoistTry 70, blankLinesBetweenScopes 62,
# repeatedGuard 49, spaceAroundOperators 41). Promote one rule per commit — add it to
# --rules above and reformat only the files that commit already touches:
#   andOperator,blankLinesAroundMark,blankLinesAtEndOfScope,blankLinesAtStartOfScope,blankLinesBetweenScopes,braces,conditionalAssignment,consecutiveBlankLines,consecutiveSpaces,contentBuilder,docComments,elseOnSameLine,hoistAwait,hoistPatternLet,hoistTry,indent,modifierOrder,noForceUnwrapInTests,numberFormatting,opaqueGenericParameters,preferKeyPath,redundantAsync,redundantClosure,redundantEmptyView,redundantLet,redundantMemberwiseInit,redundantNilInit,redundantParens,redundantReturn,redundantSelf,redundantThrows,redundantType,redundantVariable,repeatedGuard,s,simplifyGenericConstraints,sortImports,spaceAroundBraces,spaceAroundOperators,trailingClosures,trailingCommas,unusedArguments,wrapArguments,wrapFunctionBodies,wrapIfExpressionBodies,wrapIfStatementBodies,wrapLoopBodies,wrapMultilineStatementBraces,wrapPropertyBodies
